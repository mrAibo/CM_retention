#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
APP_HOME=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)
ENV_FILE=${CM_RETENTION_ENV:-${APP_HOME}/.env}

if [[ ${1:-} == "--env" ]]; then
    if [[ $# -lt 2 ]]; then
        echo "ERROR: --env requires a file path" >&2
        exit 2
    fi
    ENV_FILE=$2
    shift 2
fi

read_env_value() {
    local key=$1
    local file=$2
    [[ -f "$file" ]] || return 0
    awk -v wanted="$key" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        {
            line=$0
            pos=index(line, "=")
            if (pos == 0) next
            key=substr(line, 1, pos-1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            if (key != wanted) next
            value=substr(line, pos+1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            if ((substr(value,1,1) == "\"" && substr(value,length(value),1) == "\"") ||
                (substr(value,1,1) == "\047" && substr(value,length(value),1) == "\047")) {
                value=substr(value,2,length(value)-2)
            }
            print value
            exit
        }
    ' "$file"
}

preflight_fail() {
    local label=$1 detail=$2
    if [[ ${DOCTOR_MODE:-0} == 1 ]]; then
        printf '[FAIL] %-24s %s\n' "$label" "$detail" >&2
    else
        echo "ERROR: $detail" >&2
    fi
    exit 2
}

preflight_ok() {
    if [[ ${DOCTOR_MODE:-0} == 1 ]]; then
        printf '[OK]   %-24s %s\n' "$1" "$2"
    fi
}

DOCTOR_MODE=0
[[ ${1:-} == doctor ]] && DOCTOR_MODE=1

HAS_FILE=0
HAS_BACKFILL=0
HAS_DRY_RUN=0
HAS_INLINE_BATCH=0
for arg in "$@"; do
    [[ "$arg" == --file ]] && HAS_FILE=1
    [[ "$arg" == --backfill ]] && HAS_BACKFILL=1
    [[ "$arg" == --dry-run ]] && HAS_DRY_RUN=1
done

# A comma-separated first positional ItemType argument is a convenience form
# for batch mode. The actual normalization happens only after normal preflight;
# here we only decide which execution engine must be used.
if [[ $HAS_FILE -eq 0 && ( ${1:-} == assign || ${1:-} == unassign ) ]]; then
    for ((i=2; i<=$#; i++)); do
        arg=${!i}
        case "$arg" in
            --yes|--dry-run|--backfill) continue ;;
            --*) continue ;;
            *)
                [[ "$arg" == *,* ]] && HAS_INLINE_BATCH=1
                break
                ;;
        esac
    done
fi

NEEDS_CONFIG=1
case ${1:-} in
    version|--version|help|--help|-h|selftest) NEEDS_CONFIG=0 ;;
esac
for arg in "$@"; do
    if [[ "$arg" == --help || "$arg" == -h ]]; then
        NEEDS_CONFIG=0
    fi
done

if [[ -f "$ENV_FILE" ]]; then
    preflight_ok "configuration file" "$ENV_FILE"
    mode=$(stat -Lc '%a' "$ENV_FILE")
    if (( (8#$mode & 077) != 0 )); then
        preflight_fail "configuration mode" "insecure permissions on $ENV_FILE: $mode (expected 600 or stricter)"
    fi
    preflight_ok "configuration mode" "$mode"
elif [[ $NEEDS_CONFIG == 1 ]]; then
    preflight_fail "configuration file" "configuration file not found: $ENV_FILE"
fi

: "${IBMCMROOT:=$(read_env_value IBMCMROOT "$ENV_FILE")}" 
: "${JAVA_HOME:=$(read_env_value JAVA_HOME "$ENV_FILE")}" 
: "${ORACLE_HOME:=$(read_env_value ORACLE_HOME "$ENV_FILE")}" 
: "${CM_RETENTION_LOG_DIR:=$(read_env_value CM_RETENTION_LOG_DIR "$ENV_FILE")}" 
IBMCMROOT=${IBMCMROOT:-/opt/IBM/db2cmv8}
JAVA_HOME=${JAVA_HOME:-/opt/IBM/WebSphere/AppServer/java/8.0}
CM_RETENTION_LOG_DIR=${CM_RETENTION_LOG_DIR:-${APP_HOME}/logs}

JAVA=${JAVA_HOME}/bin/java
[[ -x "$JAVA" ]] || preflight_fail "Java executable" "Java runtime not executable: $JAVA"
preflight_ok "Java executable" "$JAVA"

SDK=${IBMCMROOT}/lib/cmbicmsdk81.jar
[[ -f "$SDK" ]] || preflight_fail "IBM CM SDK" "IBM CM SDK not found: $SDK"
preflight_ok "IBM CM SDK" "$SDK"

[[ -d "${IBMCMROOT}/lib" ]] || preflight_fail "native library path" "IBM CM library directory not found: ${IBMCMROOT}/lib"
preflight_ok "native library path" "${IBMCMROOT}/lib"

[[ -d "${IBMCMROOT}/cmgmt" ]] || preflight_fail "CM configuration" "IBM CM configuration directory not found: ${IBMCMROOT}/cmgmt"
preflight_ok "CM configuration" "${IBMCMROOT}/cmgmt"

JAR=${APP_HOME}/build/cm-retention.jar
VERSION_FILE=${APP_HOME}/build/.version
SOURCE_MAIN=${APP_HOME}/src/CmRetention.java
[[ -f "$JAR" ]] || preflight_fail "application jar" "tool is not built: $JAR (run: ${APP_HOME}/build.sh)"
[[ -f "$VERSION_FILE" ]] || preflight_fail "build version" "build version file is missing; rebuild or deploy a complete runtime bundle"

BUILT_VERSION=$(tr -d '[:space:]' < "$VERSION_FILE")
[[ -n "$BUILT_VERSION" ]] || preflight_fail "build version" "empty build version file: $VERSION_FILE"

if [[ -f "$SOURCE_MAIN" ]]; then
    EXPECTED_VERSION=$(sed -n 's/^[[:space:]]*static final String VERSION = "\([^"]*\)";[[:space:]]*$/\1/p' "$SOURCE_MAIN" | head -n 1)
    [[ -n "$EXPECTED_VERSION" ]] || preflight_fail "source version" "unable to determine version from $SOURCE_MAIN"
    if [[ "$BUILT_VERSION" != "$EXPECTED_VERSION" ]]; then
        preflight_fail "build version" "stale build: source is $EXPECTED_VERSION but build is $BUILT_VERSION; run: ${APP_HOME}/build.sh"
    fi
fi

preflight_ok "application jar" "$JAR"
preflight_ok "build version" "$BUILT_VERSION"

for source in "${APP_HOME}/src/"*.java "${APP_HOME}/build.sh"; do
    if [[ -e "$source" && "$source" -nt "$JAR" ]]; then
        preflight_fail "build freshness" "source is newer than the application jar: $source; run: ${APP_HOME}/build.sh"
    fi
done
preflight_ok "build freshness" "source and build artifact are in sync"

if [[ $DOCTOR_MODE == 1 ]]; then
    echo
    echo "Java / IBM CM checks"
fi

export IBMCMROOT JAVA_HOME CM_RETENTION_LOG_DIR
if [[ -n "${ORACLE_HOME:-}" ]]; then
    export ORACLE_HOME
fi
if [[ -f "$ENV_FILE" ]]; then
    export CM_RETENTION_ENV_FILE="$ENV_FILE"
fi

# JDBC drivers used only by explicit --backfill. BACKFILL_JDBC_JAR is the
# preferred database-neutral setting; legacy DB2/Oracle names remain accepted.
# A missing explicitly configured driver is fatal for --backfill (and surfaced
# by doctor), but does not block ordinary CM-SDK commands that never open the
# direct JDBC connection.
BACKFILL_JDBC_JAR=${BACKFILL_JDBC_JAR:-$(read_env_value BACKFILL_JDBC_JAR "$ENV_FILE")}
DB2_JDBC_JAR=${DB2_JDBC_JAR:-$(read_env_value DB2_JDBC_JAR "$ENV_FILE")}
ORACLE_JDBC_JAR=${ORACLE_JDBC_JAR:-$(read_env_value ORACLE_JDBC_JAR "$ENV_FILE")}

JDBC_JARS=()
add_jdbc_jar() {
    local jar=$1
    local explicit=${2:-0}
    [[ -n "$jar" ]] || return 0
    if [[ ! -f "$jar" ]]; then
        if [[ $explicit -eq 1 && ( $HAS_BACKFILL -eq 1 || $DOCTOR_MODE -eq 1 ) ]]; then
            preflight_fail "JDBC driver" "configured JDBC driver does not exist: $jar"
        fi
        return 0
    fi
    local existing
    for existing in "${JDBC_JARS[@]:-}"; do
        [[ "$existing" == "$jar" ]] && return 0
    done
    JDBC_JARS+=("$jar")
}

if [[ -n "$BACKFILL_JDBC_JAR" ]]; then
    add_jdbc_jar "$BACKFILL_JDBC_JAR" 1
else
    [[ -n "$DB2_JDBC_JAR" ]] && add_jdbc_jar "$DB2_JDBC_JAR" 1
    [[ -n "$ORACLE_JDBC_JAR" ]] && add_jdbc_jar "$ORACLE_JDBC_JAR" 1

    # Add any discoverable compatible drivers as well; duplicates are ignored.
    # This keeps mixed/transition installations deterministic even if one legacy
    # driver setting is already present.
    for candidate in \
        "${IBMCMROOT}/lib/db2jcc4.jar" \
        "${IBMCMROOT}/lib/db2jcc.jar" \
        "/opt/IBM/db2/V11.5/java/db2jcc4.jar" \
        "/opt/ibm/db2/V11.5/java/db2jcc4.jar" \
        "${IBMCMROOT}/lib/ojdbc8.jar" \
        "${JAVA_HOME}/../OracleLibs/ojdbc8.jar" \
        "/opt/IBM/WebSphere/AppServer/OracleLibs/ojdbc8.jar"; do
        add_jdbc_jar "$candidate" 0
    done
    if [[ -n "${ORACLE_HOME:-}" ]]; then
        add_jdbc_jar "${ORACLE_HOME}/jdbc/lib/ojdbc8.jar" 0
    fi
fi

EXTRA_CP=""
for jdbc_jar in "${JDBC_JARS[@]:-}"; do
    [[ -n "$jdbc_jar" ]] || continue
    EXTRA_CP="${EXTRA_CP}:${jdbc_jar}"
    preflight_ok "JDBC driver" "$jdbc_jar"
done

export CLASSPATH="${JAR}:${IBMCMROOT}/cmgmt:${IBMCMROOT}/lib/*${EXTRA_CP}${CLASSPATH:+:${CLASSPATH}}"
export LD_LIBRARY_PATH="${IBMCMROOT}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

BATCH_ORIGINAL_ARGS=()
INLINE_BATCH_ARGS=()
INLINE_BATCH_FILE=""

cleanup_inline_batch_file() {
    if [[ -n "$INLINE_BATCH_FILE" && -f "$INLINE_BATCH_FILE" ]]; then
        rm -f -- "$INLINE_BATCH_FILE"
    fi
}

normalize_inline_batch_args() {
    local -a args=("$@")
    local -a raw_items=()
    local -A seen=()
    local command=${args[0]:-}
    local spec_index=-1
    local spec=""
    local arg raw item
    local i count=0

    for ((i=1; i<${#args[@]}; i++)); do
        arg=${args[$i]}
        case "$arg" in
            --yes|--dry-run|--backfill) continue ;;
            --*) continue ;;
            *)
                spec_index=$i
                spec=$arg
                break
                ;;
        esac
    done

    if [[ $spec_index -lt 0 || "$spec" != *,* ]]; then
        echo "ERROR: internal inline batch normalization failed: comma-separated ItemType list not found" >&2
        return 2
    fi

    if ! INLINE_BATCH_FILE=$(mktemp "${TMPDIR:-/tmp}/cm-retention-items.XXXXXX"); then
        echo "ERROR: unable to create temporary ItemType batch file" >&2
        return 2
    fi
    chmod 600 "$INLINE_BATCH_FILE" 2>/dev/null || true
    trap cleanup_inline_batch_file EXIT

    IFS=',' read -r -a raw_items <<< "$spec"
    : > "$INLINE_BATCH_FILE"
    for raw in "${raw_items[@]}"; do
        item="${raw#"${raw%%[![:space:]]*}"}"
        item="${item%"${item##*[![:space:]]}"}"
        if [[ -z "$item" ]]; then
            echo "ERROR: comma-separated ItemType list contains an empty entry" >&2
            return 2
        fi
        if [[ -n ${seen[$item]+x} ]]; then
            echo "ERROR: duplicate ItemType '$item' in comma-separated list" >&2
            return 2
        fi
        seen["$item"]=1
        if ! printf '%s\n' "$item" >> "$INLINE_BATCH_FILE"; then
            echo "ERROR: unable to write temporary ItemType batch file" >&2
            return 2
        fi
        count=$((count + 1))
    done

    if (( count < 2 )); then
        echo "ERROR: comma-separated batch syntax requires at least two ItemTypes" >&2
        return 2
    fi

    INLINE_BATCH_ARGS=("$command" "--file" "$INLINE_BATCH_FILE")
    for ((i=1; i<${#args[@]}; i++)); do
        [[ $i -eq $spec_index ]] && continue
        INLINE_BATCH_ARGS+=("${args[$i]}")
    done
}

run_batch() {
    "$JAVA" -cp "$CLASSPATH" BatchMain "$@"
}

run_batch_with_audit() {
    local timestamp log_file retry_file batch_rc verify_rc final_rc
    timestamp=$(date '+%Y%m%d-%H%M%S')

    if ! mkdir -p "$CM_RETENTION_LOG_DIR"; then
        echo "ERROR: unable to create batch log directory: $CM_RETENTION_LOG_DIR" >&2
        return 2
    fi
    chmod 700 "$CM_RETENTION_LOG_DIR" 2>/dev/null || true

    log_file="${CM_RETENTION_LOG_DIR}/cm-retention-batch-${timestamp}-$$-${1}.log"
    retry_file="${CM_RETENTION_LOG_DIR}/cm-retention-batch-${timestamp}-$$-${1}-retry.txt"
    if ! (umask 077; : > "$log_file"); then
        echo "ERROR: unable to create batch audit log: $log_file" >&2
        return 2
    fi

    {
        echo "cm-retention batch audit"
        echo "version=$BUILT_VERSION"
        echo "started=$(date '+%Y-%m-%dT%H:%M:%S%z')"
        echo "user=$(id -un 2>/dev/null || echo unknown)"
        echo "host=$(hostname 2>/dev/null || echo unknown)"
        if (( ${#BATCH_ORIGINAL_ARGS[@]} > 0 )); then
            printf 'command='
            printf ' %q' "${BATCH_ORIGINAL_ARGS[@]}"
            printf '\n'
            printf 'normalized_command='
            printf ' %q' "$@"
            printf '\n'
        else
            printf 'command='
            printf ' %q' "$@"
            printf '\n'
        fi
        echo "source_env=$ENV_FILE"
        echo "--- batch output ---"
    } >> "$log_file"

    echo "Audit log: $log_file"

    if "$JAVA" -cp "$CLASSPATH" BatchMain "$@" \
        > >(tee -a "$log_file") \
        2> >(tee -a "$log_file" >&2); then
        batch_rc=0
    else
        batch_rc=$?
    fi
    wait || true

    verify_rc=0
    if [[ $HAS_DRY_RUN -eq 0 ]] && grep -Fq "Phase 2/2: applying changes" "$log_file"; then
        {
            echo
            echo "--- independent final verifier ---"
        } >> "$log_file"
        echo
        echo "Starting independent final verification..."

        if CM_RETENTION_RETRY_FILE="$retry_file" \
            "$JAVA" -cp "$CLASSPATH" BatchVerifyMain "$@" \
            > >(tee -a "$log_file") \
            2> >(tee -a "$log_file" >&2); then
            verify_rc=0
        else
            verify_rc=$?
        fi
        wait || true
    else
        echo "Final verification: skipped (dry-run, validation-only, or cancelled before write phase)." \
            | tee -a "$log_file"
    fi

    final_rc=$batch_rc
    if [[ $batch_rc -eq 0 && $verify_rc -ne 0 ]]; then
        # A write batch that appeared successful but cannot be independently
        # verified is a persisted/verification condition, not a clean success.
        final_rc=6
    elif [[ $batch_rc -eq 6 ]]; then
        final_rc=6
    fi

    {
        echo
        echo "--- audit summary ---"
        echo "batch_rc=$batch_rc"
        echo "verifier_rc=$verify_rc"
        echo "final_rc=$final_rc"
        echo "finished=$(date '+%Y-%m-%dT%H:%M:%S%z')"
    } >> "$log_file"

    echo "Audit log: $log_file"
    if [[ -f "$retry_file" ]]; then
        chmod 600 "$retry_file" 2>/dev/null || true
        echo "Retry file: $retry_file"
    fi

    return "$final_rc"
}

run_single_backfill() {
    "$JAVA" -cp "$CLASSPATH" SingleBackfillMain "$@"
}

if [[ $HAS_INLINE_BATCH -eq 1 ]]; then
    BATCH_ORIGINAL_ARGS=("$@")
    if normalize_inline_batch_args "$@"; then
        set -- "${INLINE_BATCH_ARGS[@]}"
        HAS_FILE=1
    else
        rc=$?
        exit "$rc"
    fi
fi

if [[ $HAS_FILE -eq 1 ]]; then
    case ${1:-} in
        assign|unassign)
            if run_batch_with_audit "$@"; then
                exit 0
            else
                exit $?
            fi
            ;;
        *)
            echo "ERROR: --file is supported only for assign and unassign" >&2
            exit 2
            ;;
    esac
fi

if [[ $HAS_BACKFILL -eq 1 ]]; then
    if [[ ${1:-} != assign ]]; then
        echo "ERROR: --backfill is supported only for the top-level assign command" >&2
        exit 2
    fi
    run_single_backfill "$@"
    exit $?
fi

exec "$JAVA" -cp "$CLASSPATH" CmRetention "$@"
