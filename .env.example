# IBM Content Manager connection alias from cmbicmsrvs.ini
CM_DATABASE=LSDB

# IBM Content Manager user, not necessarily the DB2 operating-system user
CM_USER=icmadmin
CM_PASSWORD=CHANGE_ME

# Local IBM CM and Java installations
IBMCMROOT=/opt/IBM/db2cmv8
JAVA_HOME=/opt/IBM/WebSphere/AppServer/java/8.0

# Optional DB2 settings used ONLY by explicit --backfill operations.
# If omitted, DB2 database/user/password default to the CM values above.
# Set DB2_JDBC_URL explicitly when the CM alias is not also a usable DB2 alias.
# Examples:
#   DB2_JDBC_URL=jdbc:db2:LSDB
#   DB2_JDBC_URL=jdbc:db2://dbhost.example:50000/LSDB
# DB2_DATABASE=LSDB
# DB2_JDBC_URL=jdbc:db2:LSDB
# DB2_USER=icmadmin
# DB2_PASSWORD=CHANGE_ME
# DB2_SCHEMA=ICMADMIN

# Optional path to db2jcc4.jar if it is not already under IBMCMROOT/lib
# and cannot be found in the standard DB2 V11.5 installation paths.
# DB2_JDBC_JAR=/opt/IBM/db2/V11.5/java/db2jcc4.jar
