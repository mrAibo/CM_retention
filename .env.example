# IBM Content Manager connection alias from cmbicmsrvs.ini
CM_DATABASE=LSDB

# IBM Content Manager user
CM_USER=icmadmin
CM_PASSWORD=CHANGE_ME

# Local IBM CM and Java installations
IBMCMROOT=/opt/IBM/db2cmv8
JAVA_HOME=/opt/IBM/WebSphere/AppServer/java/8.0

# For CM installations backed by Oracle, ORACLE_HOME helps the launcher locate
# ojdbc8.jar automatically. It is optional when the driver is already on the
# inherited CLASSPATH or BACKFILL_JDBC_JAR is set explicitly.
# ORACLE_HOME=/u01/app/oracle/product/19.0.0/dbhome_1

# ---------------------------------------------------------------------------
# Optional direct-database settings used ONLY by explicit --backfill.
# Normal policy/itemtype/create/assign/unassign commands use the IBM CM SDK and
# do not require BACKFILL_* settings.
#
# BACKFILL_DB_TYPE may be db2, oracle, or auto. When omitted/auto, the type is
# detected from BACKFILL_JDBC_URL. For backward compatibility, an installation
# with no BACKFILL_* settings keeps the old DB2 default jdbc:db2:<CM_DATABASE>.
# ---------------------------------------------------------------------------

# Preferred database-neutral settings:
# BACKFILL_DB_TYPE=auto
# BACKFILL_JDBC_URL=jdbc:db2:LSDB
# BACKFILL_USER=icmadmin
# BACKFILL_PASSWORD=CHANGE_ME
# BACKFILL_SCHEMA=ICMADMIN
# BACKFILL_JDBC_JAR=/opt/IBM/db2/V11.5/java/db2jcc4.jar

# DB2 network example:
# BACKFILL_DB_TYPE=db2
# BACKFILL_JDBC_URL=jdbc:db2://dbhost.example:50000/LSDB
# BACKFILL_USER=icmadmin
# BACKFILL_PASSWORD=CHANGE_ME
# BACKFILL_SCHEMA=ICMADMIN
# BACKFILL_JDBC_JAR=/opt/IBM/db2/V11.5/java/db2jcc4.jar

# Oracle 19c example (CM 8.7):
# BACKFILL_DB_TYPE=oracle
# BACKFILL_JDBC_URL=jdbc:oracle:thin:@//dbhost.example:1521/LSDB
# BACKFILL_USER=icmconct
# BACKFILL_PASSWORD=CHANGE_ME
# BACKFILL_SCHEMA=ICMADMIN
# BACKFILL_JDBC_JAR=/u01/app/oracle/product/19.0.0/dbhome_1/jdbc/lib/ojdbc8.jar

# Legacy aliases remain accepted for existing installations:
# DB2_DATABASE=LSDB
# DB2_JDBC_URL=jdbc:db2:LSDB
# DB2_USER=icmadmin
# DB2_PASSWORD=CHANGE_ME
# DB2_SCHEMA=ICMADMIN
# DB2_JDBC_JAR=/opt/IBM/db2/V11.5/java/db2jcc4.jar
#
# Oracle-specific aliases are also accepted, although BACKFILL_* is preferred:
# ORACLE_JDBC_URL=jdbc:oracle:thin:@//dbhost.example:1521/LSDB
# ORACLE_USER=icmconct
# ORACLE_PASSWORD=CHANGE_ME
# ORACLE_SCHEMA=ICMADMIN
# ORACLE_JDBC_JAR=/u01/app/oracle/product/19.0.0/dbhome_1/jdbc/lib/ojdbc8.jar
